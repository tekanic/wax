// Wax plugin interface, v0.2.
//
// Implemented by the host so far: manifest, on-message-received,
// get-sender-view / on-sender-key, and the host functions log, config,
// storage and senders. commands / run-command / panel are called later;
// plugins return empty values for now. message-text and http-get answer
// "not available yet".
//
// v0.2: sender views (the Sweep), the `senders` host function and the
// `file-sender` action.
//
// Design rules:
// - Plugins are WebAssembly components run by wasmtime, with no files, no
//   network and a time and memory limit on every call.
// - Plugins never mutate mail directly. They return `action`s; the core
//   checks each one against the permissions the user granted, then applies it.
// - Plugins never draw GPUI views. They return a small declarative `ui-node`
//   tree that the core renders with its own components.
// - Everything a plugin may read arrives as arguments or through `host`,
//   which is permission-checked too.

package wax:plugin@0.2.0;

interface types {
    record address {
        name: option<string>,
        email: string,
    }

    record envelope {
        account: string,
        mailbox: string,
        id: string,
        message-id: option<string>,
        %from: list<address>,
        to: list<address>,
        subject: string,
        // RFC 3339, UTC.
        date: option<string>,
        %flags: list<string>,
        labels: list<string>,
    }

    /// What a plugin asks the core to do. Applied only if permitted.
    variant action {
        add-label(string),
        remove-label(string),
        move-to(string),
        mark-read(bool),
        star(bool),
        archive,
        /// Hide until the given RFC 3339 time, then return to the inbox.
        snooze-until(string),
        /// Show a transient message in the status bar.
        notify(string),
        /// Open the composer with a prefilled draft.
        open-draft(draft),
        /// File all of a sender's mail, past and future: the core writes a
        /// sender rule and moves their mail, after its undo window.
        file-sender(sender-decision),
    }

    record sender-decision {
        email: string,
        name: string,
        /// How many messages it covers, for the status bar.
        count: u64,
        /// A label, or none to keep them in the Inbox.
        destination: option<string>,
    }

    /// Someone who sends you mail, from the local cache of All Mail.
    record sender {
        email: string,
        name: string,
        count: u64,
        unread: u64,
        /// Newest message, Unix seconds.
        latest: s64,
        /// Their sender rule: "keep" or a label name.
        rule: option<string>,
    }

    /// A key in a sender view. Pressing it calls on-sender-key.
    record view-key {
        /// One character, e.g. "r".
        key: string,
        /// Shown in the legend; a row whose rule matches it is drawn in `color`.
        label: string,
        about: string,
        /// 0xRRGGBB.
        color: u32,
    }

    /// A keyboard-driven list of senders the core draws (the Sweep).
    record sender-view {
        title: string,
        keys: list<view-key>,
        rows: list<sender>,
    }

    record draft {
        to: list<address>,
        subject: string,
        body-markdown: string,
        in-reply-to: option<string>,
    }

    /// A palette command or a button beside an open message.
    record command {
        id: string,
        title: string,
        /// Zed-style keystroke, e.g. "cmd-shift-s". Optional.
        keybinding: option<string>,
        /// Show as a button in the reader when a message is open.
        in-message-toolbar: bool,
    }

    /// Declarative UI for sidebar panels. Rendered by the core.
    variant ui-node {
        text(string),
        heading(string),
        badge(string),
        divider,
        /// Clicking runs the plugin command with this id.
        button(ui-button),
        column(list<ui-node-ref>),
        row(list<ui-node-ref>),
    }

    record ui-button {
        label: string,
        command-id: string,
    }

    /// Index into the flat node list returned with a panel
    /// (WIT has no recursive types).
    type ui-node-ref = u32;

    record panel {
        title: string,
        /// Node 0 is the root.
        nodes: list<ui-node>,
    }

    enum permission {
        /// Read envelopes (headers, flags, labels).
        read-envelopes,
        /// Read full message bodies.
        read-bodies,
        /// Return label / move / flag / archive / snooze actions.
        modify-mail,
        /// Return open-draft actions.
        compose,
        /// Outbound HTTPS to hosts listed in the manifest.
        network,
        /// Private key-value storage.
        storage,
    }

    record manifest {
        id: string,
        name: string,
        version: string,
        permissions: list<permission>,
        /// Hosts allowed when `network` is granted, e.g. "api.example.com".
        network-hosts: list<string>,
    }
}

/// Services the core offers to plugins. Every call is permission-checked.
interface host {
    use types.{envelope, sender};

    log: func(message: string);

    /// The plugin's own config.toml (in its folder), or "" if there is none.
    /// No permission needed: it's the plugin's own settings.
    config: func() -> string;

    /// Needs `read-bodies`. Plain text of a message.
    message-text: func(account: string, mailbox: string, id: string) -> result<string, string>;

    /// Needs `network`, and the host must be in the manifest.
    http-get: func(url: string) -> result<string, string>;

    /// Needs `read-envelopes`. Senders of an account by volume, at most `limit`.
    senders: func(account: string, limit: u32) -> result<list<sender>, string>;

    /// Needs `storage`. Per-plugin key-value store.
    storage-get: func(key: string) -> option<string>;
    storage-set: func(key: string, value: string);
}

world plugin {
    use types.{envelope, action, command, panel, manifest, sender, sender-view};

    import host;

    /// Called once at load. Declares identity and requested permissions.
    export manifest: func() -> manifest;

    /// Called for each new message after sync (needs `read-envelopes`).
    export on-message-received: func(message: envelope) -> list<action>;

    /// Commands for the palette and message toolbar.
    export commands: func() -> list<command>;

    /// Runs a command. `message` is set when invoked on an open message.
    export run-command: func(id: string, message: option<envelope>) -> result<list<action>, string>;

    /// Optional sidebar panel; return none for no panel.
    export panel: func() -> option<panel>;

    /// The Sweep: a sender view for an account, or none if this plugin has
    /// none (needs `read-envelopes`). Opened with g w.
    export get-sender-view: func(account: string) -> option<sender-view>;

    /// A view key was pressed on a row of this plugin's sender view.
    export on-sender-key: func(account: string, who: sender, key: string) -> result<list<action>, string>;
}
