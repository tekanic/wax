// Wax plugin interface, v0.4.
//
// Implemented by the host: manifest, on-message-received, commands /
// run-command, get-sender-view / on-sender-key, and the host functions
// log, config, storage, senders, knows-sender, utc-offset, read-message
// and message-text. panel is called later; plugins return none for now.
// http-get answers "not available yet".
//
// v0.4: read-message (text, links, headers, attachment names) and
// message-text work, for new mail, under read-bodies.
// v0.3: commands run (menu of choices, typed text, reader buttons, keys),
// the `follow-up` action and `snooze-until` are carried out, `utc-offset`.
// v0.2: sender views (the Sweep), `senders`, `knows-sender`, `file-sender`.
//
// Design rules:
// - Plugins are WebAssembly components run by wasmtime, with no files, no
//   network and a time and memory limit on every call.
// - Plugins never mutate mail directly. They return `action`s; the core
//   checks each one against the permissions the user granted, then applies it.
// - Plugins never draw GPUI views. They return a small declarative `ui-node`
//   tree that the core renders with its own components.
// - Everything a plugin may read arrives as arguments or through `host`,
//   which is permission-checked too.

package wax:plugin@0.4.0;

interface types {
    record address {
        name: option<string>,
        email: string,
    }

    record envelope {
        account: string,
        mailbox: string,
        id: string,
        message-id: option<string>,
        %from: list<address>,
        /// To and Cc recipients.
        to: list<address>,
        subject: string,
        // RFC 3339, UTC.
        date: option<string>,
        %flags: list<string>,
        /// Gmail labels as the server lists them; system ones start with a
        /// backslash: \Important, \Inbox.
        labels: list<string>,
    }

    /// What a plugin asks the core to do. Applied only if permitted.
    variant action {
        add-label(string),
        remove-label(string),
        move-to(string),
        mark-read(bool),
        star(bool),
        archive,
        /// Hide until the given RFC 3339 time, then return to the Inbox
        /// unread. A time already past brings it back now.
        snooze-until(string),
        /// At the given RFC 3339 time, bring this message back to the Inbox
        /// unless someone else has written in its thread since.
        follow-up(string),
        /// Show a transient message in the status bar.
        notify(string),
        /// Open the composer with a prefilled draft.
        open-draft(draft),
        /// File all of a sender's mail, past and future: the core writes a
        /// sender rule and moves their mail, after its undo window.
        file-sender(sender-decision),
    }

    record sender-decision {
        email: string,
        name: string,
        /// How many messages it covers, for the status bar.
        count: u64,
        /// A label, or none to keep them in the Inbox.
        destination: option<string>,
    }

    /// Someone who sends you mail, from the local cache of All Mail.
    record sender {
        email: string,
        name: string,
        count: u64,
        unread: u64,
        /// Newest message, Unix seconds.
        latest: s64,
        /// Their sender rule: "keep" or a label name.
        rule: option<string>,
    }

    /// A key in a sender view. Pressing it calls on-sender-key.
    record view-key {
        /// One character, e.g. "r".
        key: string,
        /// Shown in the legend; a row whose rule matches it is drawn in `color`.
        label: string,
        about: string,
        /// 0xRRGGBB.
        color: u32,
    }

    /// A keyboard-driven list of senders the core draws (the Sweep).
    record sender-view {
        title: string,
        keys: list<view-key>,
        rows: list<sender>,
    }

    record draft {
        to: list<address>,
        subject: string,
        body-markdown: string,
        in-reply-to: option<string>,
    }

    /// A command on the selected message: a key in the message list and,
    /// optionally, a button in the reader.
    record command {
        id: string,
        title: string,
        /// Zed-style keystroke, e.g. "z" or "shift-z". Optional.
        keybinding: option<string>,
        /// Show as a button in the reader when a message is open.
        in-message-toolbar: bool,
        /// Which messages it's offered for.
        scope: command-scope,
        /// When not empty, running the command first shows these in a menu;
        /// the one picked is passed to run-command.
        choices: list<command-choice>,
        /// When set, the menu also takes typed text (shown as this hint);
        /// it reaches run-command as the choice "text:<what was typed>".
        text-hint: option<string>,
    }

    enum command-scope {
        any,
        /// Messages you sent.
        sent,
        /// Messages you received.
        received,
    }

    record command-choice {
        id: string,
        title: string,
        /// Shown beside the title, e.g. "Thu 8:00 AM".
        detail: string,
    }

    /// Declarative UI for sidebar panels. Rendered by the core.
    variant ui-node {
        text(string),
        heading(string),
        badge(string),
        divider,
        /// Clicking runs the plugin command with this id.
        button(ui-button),
        column(list<ui-node-ref>),
        row(list<ui-node-ref>),
    }

    record ui-button {
        label: string,
        command-id: string,
    }

    /// Index into the flat node list returned with a panel
    /// (WIT has no recursive types).
    type ui-node-ref = u32;

    record panel {
        title: string,
        /// Node 0 is the root.
        nodes: list<ui-node>,
    }

    enum permission {
        /// Read envelopes (headers, flags, labels).
        read-envelopes,
        /// Read full message bodies.
        read-bodies,
        /// Return label / move / flag / archive / snooze actions.
        modify-mail,
        /// Return open-draft actions.
        compose,
        /// Outbound HTTPS to hosts listed in the manifest.
        network,
        /// Private key-value storage.
        storage,
    }

    /// A link in a message: what it shows and where it goes.
    record link {
        text: string,
        url: string,
    }

    /// What a message says, for plugins with `read-bodies`.
    record message-content {
        /// Plain text (HTML turned into text).
        text: string,
        /// Every <a href> in the HTML part, in order (at most 500).
        links: list<link>,
        /// Every header as (name, value), folded lines joined, in order.
        headers: list<tuple<string, string>>,
        /// File names of the attachments.
        attachments: list<string>,
    }

    record manifest {
        id: string,
        name: string,
        version: string,
        permissions: list<permission>,
        /// Hosts allowed when `network` is granted, e.g. "api.example.com".
        network-hosts: list<string>,
    }
}

/// Services the core offers to plugins. Every call is permission-checked.
interface host {
    use types.{envelope, sender, message-content};

    log: func(message: string);

    /// The plugin's own config.toml (in its folder), or "" if there is none.
    /// No permission needed: it's the plugin's own settings.
    config: func() -> string;

    /// Needs `read-bodies`. Plain text of a message. Works during
    /// on-message-received, for the messages it's given.
    message-text: func(account: string, mailbox: string, id: string) -> result<string, string>;

    /// Needs `read-bodies`. Text, links, headers and attachment names, as
    /// message-text. Fetched once per message however often it's asked.
    read-message: func(account: string, mailbox: string, id: string) -> result<message-content, string>;

    /// Needs `network`, and the host must be in the manifest.
    http-get: func(url: string) -> result<string, string>;

    /// Needs `read-envelopes`. Senders of an account by volume, at most `limit`.
    senders: func(account: string, limit: u32) -> result<list<sender>, string>;

    /// Needs `read-envelopes`. Whether you know the sender of `message`:
    /// one of your own addresses, a colleague at your work domain, someone
    /// you've written to, someone with a sender rule, or someone you have
    /// other mail from (not counting the Lobby, Spam, Trash or this batch).
    knows-sender: func(message: envelope) -> bool;

    /// Seconds east of UTC on this Mac right now (for local times).
    utc-offset: func() -> s32;

    /// Needs `storage`. Per-plugin key-value store.
    storage-get: func(key: string) -> option<string>;
    storage-set: func(key: string, value: string);
}

world plugin {
    use types.{envelope, action, command, panel, manifest, sender, sender-view};

    import host;

    /// Called once at load. Declares identity and requested permissions.
    export manifest: func() -> manifest;

    /// Called for each new Inbox message after sender rules, before it's
    /// shown or announced (needs `read-envelopes`). A message moved or
    /// archived here never appears in the Inbox.
    export on-message-received: func(message: envelope) -> list<action>;

    /// The plugin's commands. Called when the plugins load and again each
    /// time a command's menu opens, so choices can show current times.
    export commands: func() -> list<command>;

    /// Runs a command on the selected message (a whole conversation's
    /// messages get the actions). `choice` is the menu pick, if any.
    export run-command: func(id: string, choice: option<string>, message: option<envelope>) -> result<list<action>, string>;

    /// Optional sidebar panel; return none for no panel.
    export panel: func() -> option<panel>;

    /// The Sweep: a sender view for an account, or none if this plugin has
    /// none (needs `read-envelopes`). Opened with g w.
    export get-sender-view: func(account: string) -> option<sender-view>;

    /// A view key was pressed on a row of this plugin's sender view.
    export on-sender-key: func(account: string, who: sender, key: string) -> result<list<action>, string>;
}
